# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_analytics
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme

# Derived — used by SQLAlchemy and Alembic
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ETL settings
STATSBOMB_COMPETITION_IDS=11,43,55      # comma-separated StatsBomb competition IDs to ingest
STATSBOMB_SEASON_IDS=90,106             # comma-separated season IDs
ELO_BASE_URL=https://www.eloratings.net
FIFA_RESULTS_URL=https://www.rsssf.org  # fallback — override with your preferred source

# Logging
LOG_LEVEL=INFO
